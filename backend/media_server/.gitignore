# Rust build artifacts
/target/
**/*.rs.bk

# Keep Cargo.lock committed for reproducible application builds.

# Local media and database files; keep the directory placeholder.
/data_vault/*
!/data_vault/.gitkeep

# Environment and local configuration
.env
*.env.*
!.env.example

# Logs
*.log

# Manual test artifacts documented in TESTING.md
/test.txt
/downloaded_file.txt
/output_chunk.bin

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
.DS_Store